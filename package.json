{
  "name": "js-mal-sdk",
  "version": "0.1.0-rc1",
  "description": "Grant, delegate, revoke and verify scoped authority for agents on MOI.",
  "keywords": [
    "moi",
    "authority",
    "delegation",
    "agents",
    "consent",
    "coco",
    "did",
    "authorization",
    "ai-agents"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/sarvalabs/js-mal-sdk#readme",
  "author": "Sarva Labs Inc. & MOI Protocol Developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarvalabs/js-mal-sdk.git"
  },
  "bugs": "https://github.com/sarvalabs/js-mal-sdk/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "contracts/authority/authority_registry.coco",
    "contracts/authority/authority_registry.yaml",
    "contracts/identity/moi_identity.coco",
    "contracts/identity/moi_identity.yaml",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "js-moi-sdk": ">=0.9.0-rc2 <0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "js-moi-sdk": "0.9.0-rc2",
    "js-polo": "^0.1.5",
    "typescript": "^5.9.2"
  }
}
